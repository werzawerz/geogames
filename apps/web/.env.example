# Copy to .env.local to run the web app against a backend. Without these it runs
# in the browser alone (scores in localStorage, no global leaderboard).

# Against `npm run dev:api` on your machine: only this line.
# VITE_API_URL=http://localhost:5321/api

# Against a Supabase project (the publishable key is meant for browsers):
# VITE_API_URL=https://<project-ref>.supabase.co/functions/v1/api
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
