{
  "name": "geogames",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @geogames/web",
    "build": "npm run build -w @geogames/web",
    "preview": "npm run preview -w @geogames/web",
    "data:build": "node packages/geodata/scripts/build-countries.ts && node packages/geodata/scripts/build-cities.ts && node packages/geodata/scripts/build-great-circles.ts",
    "data:build:offline": "node packages/geodata/scripts/build-countries.ts --offline && node packages/geodata/scripts/build-cities.ts --offline && node packages/geodata/scripts/build-great-circles.ts",
    "test": "vitest run",
    "typecheck": "tsc -p packages/geodata && tsc -p packages/games && tsc -p apps/api && tsc -p apps/web && tsc -p apps/web/e2e",
    "e2e": "playwright test",
    "dev:api": "npm run dev -w @geogames/api",
    "build:api": "npm run build -w @geogames/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
