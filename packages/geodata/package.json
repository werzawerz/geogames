{
  "name": "@geogames/geodata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Normalized, validated, multi-purpose country dataset for GeoGames",
  "exports": {
    ".": "./src/index.ts",
    "./cities": "./src/cities.ts",
    "./countries.json": "./data/countries.json",
    "./shapes": "./src/shapes.ts",
    "./blank-atlas": "./src/blank-atlas.ts",
    "./blank-atlas-shapes": "./src/blank-atlas-shapes.ts",
    "./rivers": "./src/rivers.ts",
    "./land-grid": "./src/land-grid.ts",
    "./native-names": "./src/native-names.ts"
  },
  "scripts": {
    "build:data": "node scripts/build-countries.ts && node scripts/build-cities.ts",
    "build:rivers": "node scripts/build-rivers.ts",
    "build:land-grid": "node scripts/build-land-grid.ts"
  },
  "dependencies": {
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1"
  }
}
